{
  "name": "through-the-cracks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "doppler --no-check-version run -- vite",
    "server": "doppler --no-check-version run -- node server/index.js",
    "server:dev": "doppler --no-check-version run -- nodemon server/index.js",
    "ingest": "doppler --no-check-version run -- node scripts/ingest.js --incremental",
    "ingest:full": "doppler --no-check-version run -- node scripts/ingest.js",
    "ingest:ci": "node scripts/ingest.js --incremental",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "version:next": "node scripts/version.mjs",
    "db:seed:sql": "node scripts/seed-d1.js",
    "db:d1:init": "doppler --no-check-version run -- wrangler d1 execute through-the-cracks-db --remote --file=server/schema.sql",
    "db:d1:seed": "node scripts/seed-d1.js && doppler --no-check-version run -- wrangler d1 execute through-the-cracks-db --remote --file=.cache/d1-seed.sql",
    "db:r2:seed": "doppler --no-check-version run -- node scripts/seed-r2.js",
    "song-links:prepare": "node scripts/prepare-song-links-input.js",
    "song-links:discover": "sh -c 'PY=\".kennel-hub/session/20261113-03-youtube-playlist-generator/.venv/bin/python\"; [ -x \"$PY\" ] || PY=\"python3\"; exec \"$PY\" scripts/discover-song-links.py \"$@\"' --",
    "song-links:discover:multi": "npm run song-links:discover -- --pass=multi",
    "song-links:discover:single": "npm run song-links:discover -- --pass=single",
    "song-links:discover:nightly": "npm run song-links:discover -- --pass=all --search-mode=unified --limit 2000 --min-jitter 5.0 --max-jitter 9.0 --batch-size 80 --cooldown-min 210 --cooldown-max 300 --retry-delays 20,60 --max-run-retries 8",
    "song-links:verify": "doppler --no-check-version run -- node scripts/verify-and-export-song-links.js",
    "song-links:viz": "node scripts/song-links-visualizer.js",
    "song-metadata:prepare": "node scripts/prepare-song-metadata-input.js",
    "song-metadata:discover": "doppler --no-check-version run -- python3 scripts/discover-song-metadata.py",
    "song-metadata:discover:multi": "npm run song-metadata:discover -- --pass=multi",
    "song-metadata:discover:shs": "npm run song-metadata:discover -- --pass=multi --sources=shs",
    "song-metadata:reconcile": "python3 scripts/reconcile-song-metadata.py",
    "song-metadata:atlas": "python3 scripts/build-metadata-atlas.py",
    "song-metadata:r2:pull": "doppler --no-check-version run -- node scripts/sync-metadata-r2.js pull",
    "song-metadata:r2:push-checkpoint": "doppler --no-check-version run -- node scripts/sync-metadata-r2.js push-checkpoint",
    "song-metadata:r2:push-atlas": "doppler --no-check-version run -- node scripts/sync-metadata-r2.js push-atlas --bump-manifest",
    "song-metadata:viz": "node scripts/song-metadata-visualizer.js",
    "deploy:worker": "npm run build && doppler --no-check-version run -- wrangler deploy",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.0.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.72.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "nodemon": "^3.1.14",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
